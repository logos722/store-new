{
  "name": "store-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "perf": "npm run build && npm run start",
    "lighthouse": "lighthouse http://localhost:3000 --view --preset=desktop",
    "lighthouse:mobile": "lighthouse http://localhost:3000 --view",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.72.1",
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-toastify": "^11.0.5",
    "sass": "^1.77.8",
    "sharp": "0.35.5",
    "swiper": "^12.0.3",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.8",
    "@babel/eslint-parser": "^7.24.8",
    "@tanstack/react-query-devtools": "^5.72.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "critters": "^0.0.25",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "8.5.32",
    "minimatch": "11.0.4"
  }
}
